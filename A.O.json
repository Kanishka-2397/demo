{
  "base_url": "https://www.aosmithindia.com/",
  "items": [
    {
      "name": "title",
      "selectors": "h1.product-title, h1",  
      "type": "text",
      "match": "first"
    },
    {
      "name": "Product Benefits",
      "selectors": "div.accordion.md-accordion.accordion-1",
      "type": "text",
      "match": "all"
    },
    {
        "name": "image_url",
        "selectors": ".woocommerce-product-gallery__image a",
        "type": "href",
        "match": "all"
    },
    {
        "name": "image_zoom",
        "selectors": ".woocommerce-product-gallery__image img",
        "type": "data-zoom_src",
        "match": "all"
    },


    {
        "name": "pdf_url",
        "selectors": ".brochers-wrapper a",
        "type": "href",
        "match": "all"
    }

  ],
  "action": {
    "click": {
      "selector": "i.fa.fa-search"
    },
    "fill": {
      "selector": "input#search-modal",
      "text": "{{query}}"
    }
  },
  "result_selector": "button.view_prod"
}







